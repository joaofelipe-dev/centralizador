# Supabase PostgreSQL (session-mode pooler)
# No dev: usar credenciais do projeto Supabase de desenvolvimento
# Em producao: usar credenciais do projeto Supabase de producao
DATABASE_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Session-mode pooler (usado para migrations)
DIRECT_URL="postgresql://postgres.[PROJECT_ID]:[PASSWORD]@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Gerar com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your_secret_here"

PORT=3333
CD_NETWORK_PATH="\\\\192.168.0.247\\onedrive\\Consolidado"
