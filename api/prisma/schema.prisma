generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id              String          @id @default(uuid())
  username        String          @unique
  name            String
  email           String?         @unique
  password        String
  role            String          @default("DEFAULT")
  stores          Store[]         @relation("UserStores")
  orders          Order[]
  purchaseOrders  PurchaseOrder[]
  stockMovements  StockMovement[]
  stockCounts     StockCount[]
  products        Product[]
  createdAt       DateTime       @default(now())

  @@map("users")
}

model Store {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String
  code      String?  // Sigla da loja (PT, HD, TM, ST, NA, BT, SM, CAL, CD)
  users     User[]   @relation("UserStores")
  orders    Order[]
  createdAt DateTime @default(now())

  @@map("stores")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("categories")
}

model Product {
  id                String              @id @default(uuid())
  name               String
  price              Float
  stock              Int                 @default(0)
  stockCD            Int?                // Estoque do Centro de Distribuição (sincronizado do Excel)
  categoryId         String
  category           Category            @relation(fields: [categoryId], references: [id])
  userId             String
  user               User                @relation(fields: [userId], references: [id])
  orderItems         OrderItem[]
  purchaseOrderItems PurchaseOrderItem[]
  stockMovements     StockMovement[]
  stockCountItems    StockCountItem[]
  createdAt          DateTime            @default(now())

  @@map("products")
}

model Order {
  id             String      @id @default(uuid())
  storeId        String
  store          Store       @relation(fields: [storeId], references: [id])
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  items          OrderItem[]
  stockMovements StockMovement[]
  status         String      @default("PENDING")
  orderDate      DateTime
  createdAt      DateTime    @default(now())

  @@index([storeId])
  @@index([userId])
  @@index([status])
  @@index([orderDate])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int
  currentStock Int     @default(0)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Supplier {
  id        String        @id @default(uuid())
  name      String
  type      String        // CEASA | EXTERNAL
  address   String?
  contact   String?
  purchases PurchaseOrder[]
  createdAt DateTime      @default(now())

  @@map("suppliers")
}

model PurchaseOrder {
  id        String            @id @default(uuid())
  supplierId String
  supplier  Supplier          @relation(fields: [supplierId], references: [id])
  userId    String
  user      User              @relation(fields: [userId], references: [id])
  type      String            @default("PURCHASE") // PURCHASE | SALE
  status    String            @default("DRAFT") // DRAFT | RECEIVED
  notes     String?
  items     PurchaseOrderItem[]
  movements StockMovement[]
  createdAt DateTime          @default(now())

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  productId       String
  product         Product @relation(fields: [productId], references: [id])
  quantity        Int
  unitCost        Float?

  @@map("purchase_order_items")
}

model StockMovement {
  id              String   @id @default(uuid())
  productId       String
  product         Product  @relation(fields: [productId], references: [id])
  type            String   // ENTRY | EXIT | ADJUST
  quantity        Int
  reason          String?
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  orderId         String?
  order           Order?   @relation(fields: [orderId], references: [id])
  purchaseOrderId String?
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  createdAt       DateTime @default(now())

  @@index([productId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

model StockCount {
  id        String         @id @default(uuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  status    String         @default("OPEN") // OPEN | CLOSED
  notes     String?
  items     StockCountItem[]
  createdAt DateTime       @default(now())

  @@map("stock_counts")
}

model StockCountItem {
  id            String  @id @default(uuid())
  stockCountId  String
  stockCount    StockCount @relation(fields: [stockCountId], references: [id])
  productId     String
  product       Product @relation(fields: [productId], references: [id])
  physicalQty   Int
  systemQty     Int
  divergence    Int     // physicalQty - systemQty

  @@map("stock_count_items")
}

model SyncLog {
  id          String   @id @default(uuid())
  syncedAt    DateTime @default(now())
  syncedCount Int
  fileName    String?
  fileMtime   DateTime?
  columnUsed  String?
  notFound    String   @default("[]")
  errors      String   @default("[]")

  @@map("sync_logs")
}
