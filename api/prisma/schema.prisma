generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id        String    @id @default(uuid())
  username  String    @unique
  name      String
  email     String?   @unique
  password  String
  role      String    @default("DEFAULT")
  stores    Store[]   @relation("UserStores")
  orders    Order[]
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("users")
}

model Store {
  id        String   @id @default(uuid())
  name      String   @unique
  address   String
  code      String?  // Sigla da loja (PT, HD, TM, ST, NA, BT, SM, CAL, CD)
  users     User[]   @relation("UserStores")
  orders    Order[]
  createdAt DateTime @default(now())

  @@map("stores")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  products  Product[]

  @@map("categories")
}

model Product {
  id         String      @id @default(uuid())
  name       String
  price      Float
  stock      Int         @default(0)
  stockCD    Int?        // Estoque do Centro de Distribuição (sincronizado do Excel)
  categoryId String
  category   Category    @relation(fields: [categoryId], references: [id])
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  orderItems OrderItem[]
  createdAt  DateTime    @default(now())

  @@map("products")
}

model Order {
  id        String      @id @default(uuid())
  storeId   String
  store     Store       @relation(fields: [storeId], references: [id])
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  items     OrderItem[]
  status    String      @default("PENDING")
  orderDate DateTime
  createdAt DateTime    @default(now())

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  order        Order   @relation(fields: [orderId], references: [id])
  productId   String
  product     Product @relation(fields: [productId], references: [id])
  quantity    Int
  currentStock Int     @default(0)

  @@map("order_items")
}

model SyncLog {
  id          String   @id @default(uuid())
  syncedAt    DateTime @default(now())
  syncedCount Int
  fileName    String?
  fileMtime   DateTime?
  columnUsed  String?
  notFound   String   @default("[]")
  errors      String   @default("[]")

  @@map("sync_logs")
}
